{
    "manifest_version" : 3,
    "name" : "Simply Assistant",
    "version" : "1.0.1",
    "description" : "Intercepts YouTube captions and sends to backend",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions" : ["activeTab", "storage", "tabs"],
    "host_permissions" : [
        "https://*.youtube.com/*",
        "https://simply-kwrn.onrender.com/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://*.supabase.co/*"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "popup.html",
        "default_title": "Simply Assistant"
    },
    "background" : {
        "service_worker" : "background.js"
    },
    "content_scripts" : [
        {
            "matches" : ["*://*.youtube.com/*"],
            "js" : ["inject.js"],
            "world" : "MAIN",
            "run_at" : "document_start"
        },
        {
            "matches" : ["*://*.youtube.com/*"],
            "js" : ["content.js"],
            "run_at" :"document_start"
        }
    ]
}